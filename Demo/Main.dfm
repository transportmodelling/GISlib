  object ActionList: TActionList
    Images = ImageList
    Left = 1008
    Top = 568
    object RemoveLayer: TAction
      Caption = 'Remove'
      Hint = 'Remove|Remove the selected layer'
      ImageIndex = 0
      OnExecute = RemoveLayerExecute
    end
    object LayerUp: TAction
      Caption = 'Up'
      Hint = 'Up|Move the selected layer up'
      ImageIndex = 1
      OnExecute = LayerUpExecute
    end
    object LayerDown: TAction
      Caption = 'Down'
      Hint = 'Down|Move the selected layer down'
      ImageIndex = 2
      OnExecute = LayerDownExecute
    end
    object ShowOSM: TAction
      Caption = 'OpenStreetMap'
      Hint = 'OpenStreetMap|Show OpenStreetMap tiles beneath the layers'
      ImageIndex = 3
      OnExecute = ShowOSMExecute
    end
    object AddLayer: TFileOpen
      Caption = '&Open...'
      Dialog.Filter = 
        'Geo files|*.shp;*.geojson;*.gpkg|Shapefiles|*.shp|GeoJSON files|' +
        '*.geojson|GeoPackage files|*.gpkg|All files|*.*'
      Hint = 'Open|Open a shapefile, GeoJSON or GeoPackage as a new layer'
      ImageIndex = 4
      ShortCut = 16463
      OnAccept = AddLayerAccept
    end
    object ZoomIn: TAction
      Caption = 'Zoom In'
      GroupIndex = 1
      Hint = 'Zoom In|Drag a rectangle to zoom in'
      ImageIndex = 7
      OnExecute = ZoomInExecute
    end
    object ZoomOut: TAction
      Caption = 'Zoom Out'
      GroupIndex = 1
      Hint = 'Zoom Out|Click the map to zoom out'
      ImageIndex = 8
      OnExecute = ZoomOutExecute
    end
    object Pan: TAction
      Caption = 'Pan'
      GroupIndex = 1
      Hint = 'Pan|Drag the map to move it'
      ImageIndex = 9
      OnExecute = PanExecute
    end
    object ZoomAll: TAction
      Caption = 'Zoom All'
      Hint = 'Zoom All|Zoom to fit all visible layers'
      ImageIndex = 10
      OnExecute = ZoomAllExecute
    end
    object SaveImage: TAction
      Caption = 'Save'
      Hint = 'Save image|Save the map image as PNG or BMP'
      ImageIndex = 11
      OnExecute = SaveImageExecute
    end
    object SaveLayer: TAction
      Caption = 'Save'
      Hint = 'Save layer|Save the selected layer to a file'
      ImageIndex = 6
      OnExecute = SaveLayerExecute
    end
    object SaveLayers: TAction
      Caption = 'Save all layers'
      Hint = 'Save all layers|Save every layer to one multi-layer file'
      ImageIndex = 5
      OnExecute = SaveLayersExecute
    end
  end
