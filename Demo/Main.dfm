    Top = 312
    object RemoveLayer: TAction
      Caption = 'Remove'
      Hint = 'Remove|Remove the selected layer'
      ImageIndex = 0
      ImageName = 'RemoveLayer'
      OnExecute = RemoveLayerExecute
    end
    object LayerUp: TAction
